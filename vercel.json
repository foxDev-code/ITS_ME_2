{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    {"source":"/index.html","destination":"/","statusCode":301},
    {"source":"/about","destination":"/about.html","statusCode":301},
    {"source":"/projects","destination":"/projects.html","statusCode":301},
    {"source":"/contact","destination":"/contact.html","statusCode":301},
    {"source":"/faq","destination":"/faq.html","statusCode":301}
  ],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
    {"key":"X-Frame-Options","value":"SAMEORIGIN"}
  ]}]
}
